# Bundled portable runtime (Node.js + npm, the Claude Code CLI, and Piper + its voice models) --
# too large for a git repo and not source code; see the README for setup instructions instead.
tools/
node_modules/

# Secrets -- real tokens/keys, never committed. See the matching *.local.*.example templates.
*.local.bat
*.local.json
*.local.sh
# Google hands out its OAuth client files under this name. One landed in this folder on 2026-11-08,
# untracked -- which a release would have picked up and published, because publish-release.js takes
# "everything git would publish", and untracked-but-not-ignored counts.
client_secret_*
certs/*.pem

# Personal, per-installation config -- only the example template is tracked.
net-config.json

# Runtime-generated state and output, not meaningful to publish.
.session*.json
audio_out/
presented_content/
# Files a human handed to this agent -- personal by definition, and the one folder here most
# likely to contain photos or documents that must never end up in a public repository.
/inbox/
*.log
*-log.txt
restart-log.txt
*.err

# What an update replaced (kept for going back by hand) and its half-downloaded files -- see updater.js.
.update-backup/
.update-staging/

# Superseded by the unified agent-face-overlay.user.js, kept locally for reference only.
legacy/

# This session's own pre-migration snapshot, not part of the project.
backup-de-migration/

# OS and editor cruft.
.DS_Store
Thumbs.db
.vscode/
.idea/

# What a failed Claude sign-in last said, for diagnosing one (claude-login.js). Per machine, never shared.
.login-last.log
